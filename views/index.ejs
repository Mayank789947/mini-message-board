<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= title %></h1>
    <% messages.forEach((message) => { %>
        <h2><%= message.user %> </h2>
        <p><%= message.text %> </p>
        <small><%= message.added.toLocaleString('en-IN') %></small>
        <a href="/messages/<%= message.id %>">View message</a>
    <% }) %>
</body>
</html>